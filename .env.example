# Copy to .env and fill in every value. Never commit real secrets (NFR-02).

# Postgres (docker compose)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
DB_HOST_PORT=5440

# API: a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=

# Shared password for the seeded demo personas (seed, tests, one-click login)
DEMO_PASSWORD=

# Running the API outside docker? Also set these (same passwords as above):
# DATABASE_URL=postgresql+asyncpg://hr_app:<APP_DB_PASSWORD>@localhost:5440/hr_copilot
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@localhost:5440/hr_copilot

# Coming in the assistant milestone (Day 3+)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # embeddings / speech, if chosen in the ADR
